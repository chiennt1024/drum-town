    posthog.init('{{ env.posthogToken }}', {
        api_host: '{{ env.posthogHost }}',
        defaults: '2026-05-30',
        person_profiles: 'identified_only', // or 'always' to create profiles for anonymous users as well
    })
  </script>
  {%- endif %}
</head>
<body>

{#- The skip rail (BL-073). -#}
<nav class="skip-rail" aria-label="{{ 'Skip links' if (locale or 'en') == 'en' else 'Liên kết bỏ qua' }}">
  <a class="skip-link" href="#main">{{ 'Skip to content' if (locale or 'en') == 'en' else 'Chuyển đến nội dung chính' }}</a>
  {%- if '/lessons/' in page.url %}
  <a class="skip-link" href="#exercises">{{ 'Skip to exercises' if (locale or 'en') == 'en' else 'Chuyển đến bài tập' }}</a>
  {%- endif %}
  {%- if page.url == '/' or page.url == '/vi/' %}
  <a class="skip-link" href="#chapter-index">{{ 'Jump to a chapter' if (locale or 'en') == 'en' else 'Nhảy đến một chương' }}</a>
  {%- endif %}
  <a class="skip-link" href="#site-footer">{{ 'Skip to footer' if (locale or 'en') == 'en' else 'Chuyển xuống chân trang' }}</a>
</nav>

<header class="site-header">
  <div class="site-header__inner">
    <a href="{{ '/' | localeUrl(locale or 'en') }}" class="site-logo">
      {#- The seal (BL-059). -#}
      <svg class="site-logo__seal" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect x="1" y="13.7" width="2.8" height="4.6" rx="1.3" />
        <rect x="28.2" y="13.7" width="2.8" height="4.6" rx="1.3" />
        <path d="M3.6 9.4V22.6a12.4 4.4 0 0 0 24.8 0V9.4Z" fill="currentColor" />
        <rect x="7.15" y="9.8" width="2.9" height="14.1" rx="1.45" />
        <rect x="14.55" y="9.8" width="2.9" height="15.4" rx="1.45" />
        <rect x="21.95" y="9.8" width="2.9" height="14.1" rx="1.45" />
        <path d="M3.6 22.6a12.4 4.4 0 0 0 24.8 0" fill="none" stroke="var(--gold)" stroke-width="2.6" />
        <ellipse cx="16" cy="9.4" rx="12.4" ry="4.4" stroke="currentColor" stroke-width="2" />
      </svg>
      <span class="site-logo__wm">drum<em>.town</em></span>
    </a>
    {#- Current-section highlight. -#}
    {%- set sec = navSection or (
          'track' if '/genres/' in page.url else (
          'rudiments' if '/rudiments/' in page.url else (
          'metronome' if '/metronome/' in page.url else ''))) %}
    <nav class="site-nav" id="site-nav" aria-label="Site">
      <a href="{{ '/#foundations' | localeUrl(locale or 'en') }}"{% if sec == 'foundations' %} class="active" aria-current="true"{% endif %}>{{ 'Foundations' if (locale or 'en') == 'en' else 'Nền tảng' }}</a>
      <a href="{{ '/#tracks' | localeUrl(locale or 'en') }}"{% if sec == 'track' %} class="active" aria-current="true"{% endif %}>{{ 'Genres' if (locale or 'en') == 'en' else 'Thể loại' }}</a>
      <a href="{{ '/#mastery' | localeUrl(locale or 'en') }}"{% if sec == 'mastery' %} class="active" aria-current="true"{% endif %}>{{ 'Other Topics' if (locale or 'en') == 'en' else 'Chủ đề khác' }}</a>
      <a href="{{ '/rudiments/' | localeUrl(locale or 'en') }}"{% if sec == 'rudiments' %} class="active" aria-current="page"{% endif %}>Rudiments</a>
      <a href="{{ '/metronome/' | localeUrl(locale or 'en') }}"{% if sec == 'metronome' %} class="active" aria-current="page"{% endif %}>{{ 'Metronome' if (locale or 'en') == 'en' else 'Máy đếm nhịp' }}</a>
      <button class="site-nav__theme" id="nav-theme-toggle" type="button">{{ 'Switch to dark theme' if (locale or 'en') == 'en' else 'Chuyển sang giao diện tối' }}</button>
      <div class="lang-switch" role="group" aria-label="{{ 'Language selection' if (locale or 'en') == 'en' else 'Chọn ngôn ngữ' }}">
        <a href="{{ page.url | localeUrl('en') }}" class="lang-switch__link{% if (locale or 'en') == 'en' %} is-active{% endif %}" hreflang="en" lang="en"{% if (locale or 'en') == 'en' %} aria-current="true"{% endif %}>EN</a>
        <span class="lang-switch__sep" aria-hidden="true">/</span>
        <a href="{{ page.url | localeUrl('vi') }}" class="lang-switch__link{% if locale == 'vi' %} is-active{% endif %}" hreflang="vi" lang="vi"{% if locale == 'vi' %} aria-current="true"{% endif %}>VI</a>
      </div>
    </nav>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="{{ 'Switch to dark theme' if (locale or 'en') == 'en' else 'Chuyển sang giao diện tối' }}">
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="1.8" />
        <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M12 2.4v2.6M12 19v2.6M2.4 12h2.6M19 12h2.6M5.2 5.2l1.9 1.9M16.9 16.9l1.9 1.9M18.8 5.2l-1.9 1.9M7.1 16.9l-1.9 1.9" />
        </g>
      </svg>
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20.5 14.6A8.6 8.6 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      </svg>
    </button>
    {#- Collapsed state of the transport dock (system.md §3/§7). Live BPM and
        time signature are written here by metronome.js; the lamp pulses with
        the beat so a running metronome is never hidden.

        The lamp carries no glyph (BL-074). It used to wear ▶ when stopped and ■
        when running, but pressing this button does neither — it opens and closes
        the dock, and a beginner who tapped the triangle got a drawer containing a
        second, identical triangle. The lamp is now a pure indicator (ring =
        stopped, filled = running, brass offbeat, brick downbeat) and the
        disclosure is carried by the chevron, which flips off the same
        aria-expanded this button already publishes — CSS only, no second source
        of truth in JS. -#}
    <button class="clock-pill" id="metronome-pill" type="button" aria-expanded="false" aria-controls="site-metronome">
      <span class="clock-pill__dot" aria-hidden="true"></span>
      <b class="clock-pill__bpm" aria-hidden="true">80</b><small class="clock-pill__sig" aria-hidden="true">· 4/4</small><span class="clock-pill__chev" aria-hidden="true"></span>
      {#- The whole accessible name lives in this one span rather than being
          concatenated from the visible parts: nothing separates <b> from the
          span in the rendered markup, so a composed name would run together as
          "80beats per minute". metronome.js rewrites the tempo and the running
          word here; open/closed is carried by aria-expanded, not by this text.
          The static wording below is the no-JS fallback. -#}
      <span class="sr-only" id="metronome-pill-state">{{ 'Metronome, 80 beats per minute, stopped' if (locale or 'en') == 'en' else 'Máy đếm nhịp, 80 phách/phút, đã dừng' }}</span>
    </button>
    <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="{{ 'Menu' if (locale or 'en') == 'en' else 'Menu điều hướng' }}">
      <span class="nav-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

{#- tabindex="-1" so "Skip to content" actually lands here. Without it the
    browser sets the hash and leaves focus on <body>, which is where this link
    had been quietly dumping screen-reader users. -#}
<main id="main" tabindex="-1">
{{ content | safe }}
</main>

{#- Footer — the notice board (system.md §4). Four columns at desktop, 2 at
    820px, 1 at 560px with the identity block first. Every figure on the base
    line is computed from the data files at build time, never typed: the
    counts move when the curriculum does. -#}
{%- set rudimentCount = 0 %}
{%- for group in rudiments %}{% set rudimentCount = rudimentCount + group.rudiments.length %}{% endfor %}
<footer class="site-footer" id="site-footer" tabindex="-1">
  <div class="site-footer__grid">
    <div class="site-footer__id">
      <svg class="site-footer__seal" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect x="1" y="13.7" width="2.8" height="4.6" rx="1.3" />
        <rect x="28.2" y="13.7" width="2.8" height="4.6" rx="1.3" />
        <path d="M3.6 9.4V22.6a12.4 4.4 0 0 0 24.8 0V9.4Z" fill="currentColor" />
        <rect x="7.15" y="9.8" width="2.9" height="14.1" rx="1.45" />
        <rect x="14.55" y="9.8" width="2.9" height="15.4" rx="1.45" />
        <rect x="21.95" y="9.8" width="2.9" height="14.1" rx="1.45" />
        <path d="M3.6 22.6a12.4 4.4 0 0 0 24.8 0" fill="none" stroke="var(--gold)" stroke-width="2.6" />
        <ellipse cx="16" cy="9.4" rx="12.4" ry="4.4" stroke="currentColor" stroke-width="2" />
      </svg>
      {#- The one sanctioned poetry zone on the site (system.md §10). -#}
      <p class="site-footer__motto">{{ 'The door\'s open. Bring sticks.' if (locale or 'en') == 'en' else 'Cánh cửa luôn rộng mở. Hãy mang theo dùi trống.' }}</p>
      <p class="site-footer__fine">{{ 'A free town for learning the drums. No accounts, no sign-ups — your progress lives in your own browser.' if (locale or 'en') == 'en' else 'Một không gian học trống hoàn toàn miễn phí. Không cần tài khoản, không cần đăng ký — tiến trình học tập được lưu trữ trực tiếp trên trình duyệt của bạn.' }}</p>
    </div>
    {#- aria-labelledby rather than aria-label: the heading is already the
        column's name, and a duplicate string would have screen readers
        announce "Lessons navigation, heading, Lessons". -#}
    <nav class="site-footer__col" aria-labelledby="footer-nav-lessons">
      <h2 class="site-footer__h" id="footer-nav-lessons">{{ 'Lessons' if (locale or 'en') == 'en' else 'Bài học' }}</h2>
      <ul>
        <li><a href="{{ '/#foundations' | localeUrl(locale or 'en') }}">{{ 'Foundations' if (locale or 'en') == 'en' else 'Nền tảng căn bản' }}</a></li>
        <li><a href="{{ '/#tracks' | localeUrl(locale or 'en') }}">{{ 'Genre tracks' if (locale or 'en') == 'en' else 'Lộ trình theo thể loại' }}</a></li>
        <li><a href="{{ '/#mastery' | localeUrl(locale or 'en') }}">{{ 'Other topics' if (locale or 'en') == 'en' else 'Chủ đề nâng cao' }}</a></li>
      </ul>
    </nav>
    <nav class="site-footer__col" aria-labelledby="footer-nav-reference">
      <h2 class="site-footer__h" id="footer-nav-reference">{{ 'Reference' if (locale or 'en') == 'en' else 'Tài liệu tra cứu' }}</h2>
      <ul>
        <li><a href="{{ '/rudiments/' | localeUrl(locale or 'en') }}">{{ ('The ' + rudimentCount + ' rudiments') if (locale or 'en') == 'en' else ('Trọn bộ ' + rudimentCount + ' kỹ thuật Rudiments') }}</a></li>
        <li><a href="{{ '/metronome/' | localeUrl(locale or 'en') }}">{{ 'The metronome' if (locale or 'en') == 'en' else 'Máy đếm nhịp' }}</a></li>
      </ul>
    </nav>
    <nav class="site-footer__col" aria-labelledby="footer-nav-town">
      <h2 class="site-footer__h" id="footer-nav-town">{{ 'The town' if (locale or 'en') == 'en' else 'Dự án' }}</h2>
      <ul>
        <li><a href="https://github.com/dylanpjenkins/drum-town">GitHub</a></li>
        <li><a href="{{ (curriculum.foundations.sections[0].lessons[0].slug | lessonUrl(locale or 'en')) }}">{{ 'Start at lesson one' if (locale or 'en') == 'en' else 'Bắt đầu từ bài học số 1' }}</a></li>
      </ul>
    </nav>
  </div>
  <p class="site-footer__base">drum.town · {{ curriculum | lessonCount }} {{ 'lessons' if (locale or 'en') == 'en' else 'bài học' }} · {{ lessonContent | exerciseCount }} {{ 'playable exercises' if (locale or 'en') == 'en' else 'bài tập tương tác' }} · {{ rudimentCount }} {{ 'rudiments' if (locale or 'en') == 'en' else 'kỹ thuật rudiment' }} · {{ 'notation rendered with VexFlow at build time · built on Eleventy' if (locale or 'en') == 'en' else 'ký âm kết xuất tĩnh bằng VexFlow · phát triển trên nền tảng Eleventy' }}</p>
</footer>

{#- Transport dock (system.md §7). Ships collapsed so no dock flashes open
    before metronome.js runs; the header clock pill expands it. Control IDs are
    unchanged from the old floating card — metronome.js keeps its wiring.

    Every control sits in a `.transport__field` whose `.transport__cap` names it
    in words (BL-075). At 390px the whole dock used to read "▶ ♪ ▾": the BPM
    label was display:none below 400px, so the tempo box was a naked "80", and
    the two sliders were unlabelled — one tempo, one volume, and you had to
    guess. The caps ride in the dead vertical space each 44px control already
    has above its own content, so the dock's height is unchanged and the reserve
    that tools/checks/check-transport-reserve.js enforces still holds. DOM order
    is unchanged too: the ≤720px two-row arrangement is driven by `order`, and
    the desktop row follows this source order.

    Each caption names its OWN control and nothing else. The dot row's caption
    read "Metronome" for one review cycle, on the theory that this field had the
    spare width to carry the dock's title; that was the same false affordance as
    the pill's old play triangle, one layer down — a beginner hunting for the word
    "metronome" found it, tapped it, and got nothing, because the field under it
    is decoration. It says "Beat" now, and the select next to it says "Meter"
    rather than "Beats", which also stops the row asserting that 6/8 has six
    beats. The dock has no visible title as a result; a title needs a treatment
    that is not a control caption, and that is filed separately. -#}
<aside class="transport is-collapsed" id="site-metronome" aria-label="{{ 'Metronome' if (locale or 'en') == 'en' else 'Máy đếm nhịp' }}">
  <div class="transport__row">
    <button class="transport__go" id="metronome-toggle" type="button" aria-label="{{ 'Start metronome' if (locale or 'en') == 'en' else 'Bật máy đếm nhịp' }}">
      <span class="transport__icon" aria-hidden="true">▶</span>
    </button>
    {#- Every caption is aria-hidden and every control keeps a single aria-label,
        so there is exactly one accessible name per control and the visible word
        is a substring of it — WCAG 2.5.3 is string containment, so a voice-control
        user saying "click BPM" has to land somewhere. All four pairs, in full:
          BPM     → "BPM, tempo in beats per minute"
          Tempo   → "Tempo slider"
          Meter   → "Meter, beats per bar"
          Volume  → "Volume"
        The BPM name gained its prefix here: "Tempo in beats per minute" does not
        contain the string "BPM", and while the visible label was display:none
        below 400px that was invisible as well as unspoken. A comma, not a dash —
        screen readers announce an em dash. The fifth caption, Beat, names the dot
        row, which is aria-hidden decoration and takes no name at all. -#}
    {#- autocomplete="off" on all four controls, and it is load-bearing rather
        than boilerplate. On a back/forward navigation that misses the bfcache
        the browser re-applies the form state this page had when the reader left
        it, and it does that AFTER metronome.js has restored the real values from
        localStorage. Measured: leave a page in 4/4, set 3/4 on the next lesson,
        press Back — the select snapped back to "4/4" while beatsPerBar, the dot
        row and the accent pattern were all 3. The dock was reporting a meter it
        was not going to play. localStorage is this component's single source of
        truth; the browser's copy is a second one that silently disagrees. -#}
    <label class="transport__field transport__bpm-wrap">
      <span class="transport__cap" aria-hidden="true">BPM</span>
      <input type="number" class="transport__bpm" id="metronome-bpm" value="80" min="30" max="240" step="1" autocomplete="off" aria-label="{{ 'BPM, tempo in beats per minute' if (locale or 'en') == 'en' else 'BPM, tốc độ theo phách mỗi phút' }}" />
    </label>
    <label class="transport__field transport__tempo">
      <span class="transport__cap" aria-hidden="true">Tempo</span>
      <input type="range" class="transport__slider" id="metronome-slider" min="30" max="240" step="1" value="80" autocomplete="off" aria-label="{{ 'Tempo slider' if (locale or 'en') == 'en' else 'Tempo slider, thanh trượt tốc độ' }}" />
    </label>
    {#- A div, not a label, and deliberately: a <select> inside a <label> has a
        history of taking two taps on mobile browsers, because the label forwards
        a second click into the popup that just opened. Nothing is lost — the
        caption is aria-hidden either way and the select carries its own
        aria-label, and the select fills the field, so a tap on the caption still
        lands on the control underneath it. -#}
    <div class="transport__field transport__meter">
      <span class="transport__cap" aria-hidden="true">Meter</span>
      <select class="transport__timesig" id="metronome-timesig" autocomplete="off" aria-label="{{ 'Meter, beats per bar' if (locale or 'en') == 'en' else 'Meter, số chỉ nhịp mỗi ô nhịp' }}">
        <option value="2">2/4</option>
        <option value="3">3/4</option>
        <option value="4" selected>4/4</option>
        <option value="5">5/4</option>
        <option value="6">6/8</option>
        <option value="7">7/8</option>
      </select>
    </div>
    <div class="transport__field transport__pulse">
      <span class="transport__cap" aria-hidden="true">Beat</span>
      {#- metronome.js rewrites this element's innerHTML on every time-signature
          change, so the caption has to be its sibling, not its child. -#}
      <div class="transport__beats" id="metronome-beats" aria-hidden="true"></div>
      {#- The armed message (BL-091). Empty on every page a reader has not left a
          running click behind on, and empty is zero-width, so the dock they see
          is the dock that shipped yesterday. When metronome.js fills it, the
          dots and their caption step aside and this takes the field: nothing is
          pulsing while the click is paused, so the dot row has nothing to say,
          and the swap costs the row no width at any breakpoint.

          Not a caption. The dock's five captions are uppercase, letter-spaced,
          parked at the top of a field, and each one names the control directly
          beneath it (BL-075) — this is a sentence, sits on the field's center
          line, names no control and takes no taps.

          role="status" is a best-effort extra, not the accessible path to this
          state. A live region filled by a deferred script during a page's
          initial load is commonly suppressed, and where it does fire it fires on
          every armed load, which is its own kind of noise. What carries the
          state reliably is the go button's own name, which becomes "Play, resume
          metronome at 90 BPM", and the pill's sr-only text, which says "paused"
          rather than "stopped". The role is here because when it does announce,
          it is right, and it costs nothing when it does not. -#}
      <p class="transport__status" id="metronome-status" role="status"></p>
    </div>
    <label class="transport__field transport__vol">
      <span class="transport__cap" aria-hidden="true">Volume</span>
      <input type="range" class="transport__volume" id="metronome-volume" min="0" max="100" step="1" value="60" autocomplete="off" aria-label="{{ 'Volume' if (locale or 'en') == 'en' else 'Volume, âm lượng' }}" />
    </label>
    <button class="transport__collapse" id="metronome-collapse" type="button" aria-expanded="true" aria-label="{{ 'Collapse metronome' if (locale or 'en') == 'en' else 'Thu gọn máy đếm nhịp' }}">▾</button>
  </div>
</aside>

